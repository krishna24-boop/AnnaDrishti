# Gemini API key (aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Optional Claude key. Gemini is used when both provider keys are configured.
# ANTHROPIC_API_KEY=your_key_here
# CLAUDE_MODEL=claude-sonnet-5-5

# DEMO_MODE=1

# MongoDB Atlas connection string; replace the placeholders with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=annadrishti
